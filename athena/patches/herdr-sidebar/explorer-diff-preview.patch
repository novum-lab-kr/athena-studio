+    #[test]
+    fn changed_files_carry_the_diff_a_click_opens() {
+        let deco = Decorations::build(&[repo(
+            "/ws",
+            "## main\0M  staged.rs\0MM both.rs\0 M work.rs\0?? new.rs\0",
+            &[],
+        )]);
+        let kind = |rel: &str| deco.diff_target(&root().join(rel)).map(|(_, _, k)| k);
+        assert_eq!(kind("staged.rs"), Some("staged"));
+        assert_eq!(kind("both.rs"), Some("worktree"), "working tree wins");
+        assert_eq!(kind("work.rs"), Some("worktree"));
+        assert_eq!(kind("new.rs"), Some("untracked"));
+        assert_eq!(kind("clean.rs"), None, "unchanged files open as files");
+        let (root_path, rel, _) = deco.diff_target(&root().join("work.rs")).unwrap();
+        assert_eq!((root_path, rel), (root().as_path(), "work.rs"));
+    }
