+                herdr_sidebar::viewer::diff_request(root, rel, kind),
+                herdr_sidebar::viewer::doc_key_for_diff(root, rel, kind),
+            ),
+            None => (
+                herdr_sidebar::viewer::file_request(path),
+                herdr_sidebar::viewer::doc_key_for_file(path),
+            ),
+        }
+    }
