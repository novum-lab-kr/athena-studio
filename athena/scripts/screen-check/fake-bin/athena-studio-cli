#!/usr/bin/env python3
"""가짜 athena-studio-cli(Athena Studio 데몬 CLI) — 화면 계층 회귀 검사(scripts/screen-check/check.sh)용. 진짜 데몬은 건드리지 않는다.

받은 인자를 가짜 herdr 와 같은 로그($FAKE_HERDR_LOG)에 ["@studio", 인자…] 한 줄로 적고(순서까지 비교되게), 응답은 fixture 에서 준다.
  FAKE_HERDR_FIXTURE  fixture 폴더 목록(':' 로 구분 · 앞이 우선) 중 이름이 studio 로 시작하는 폴더만 본다(herdr fixture 와 섞이지 않게)
                      파일 이름은 하위 명령 두 단어 — pane list → pane_list.json(출력 그대로 · 글자 응답(read·wait-output)은 .txt) · <이름>.exit(종료 코드) · <이름>.stderr
                      그 이름이 없으면 같은 폴더의 any.* (모든 동작에 같은 답 — 데몬 없음 등)
                      어디에도 없으면 빈 출력 · 0 (바꾸는 동작은 진짜 CLI 도 출력이 없다)
  FAKE_ATHENA         응답 안의 @ATHENA@ 를 이 경로로 바꾼다(작업 트리 사본)
  FAKE_STUDIO_SHOW_ENV=1  화면 계층이 넘긴 ATHENA_STUDIO_SOCKET · ATHENA_STUDIO_NODE 도 ["#studio-env", …] 로 적는다(접속 파일 검사)
진짜 CLI 의 계약(정본: athena-studio src/lib/protocol.js · 계획서 4절 "2) 데몬 CLI")과 같은 모양으로 fixture 를 쓴다 — 납작한 JSON 그대로.
"""
import json
import os
import sys

args = sys.argv[1:]
log = os.environ.get('FAKE_HERDR_LOG')
if log:
    with open(log, 'a', encoding='utf-8') as out:
        out.write(json.dumps(['@studio'] + args, ensure_ascii=False) + '\n')
        if os.environ.get('FAKE_STUDIO_SHOW_ENV') == '1':
            out.write(json.dumps(['#studio-env', os.environ.get('ATHENA_STUDIO_SOCKET', ''), os.environ.get('ATHENA_STUDIO_NODE', '')], ensure_ascii=False) + '\n')

words = [arg for arg in args if not arg.startswith('-')][:2]
key = '_'.join(words) or 'none'
body, code = '', 0
folders = [folder for folder in os.environ.get('FAKE_HERDR_FIXTURE', '').split(':') if os.path.basename(folder.rstrip('/')).startswith('studio')]


def answer(folder, name):
    paths = [os.path.join(folder, name + ext) for ext in ('.json', '.exit', '.stderr', '.txt')]
    if not any(os.path.isfile(path) for path in paths):
        return None
    text, exit_code = '', 0
    if os.path.isfile(paths[2]):
        with open(paths[2], encoding='utf-8') as fixture:
            sys.stderr.write(fixture.read())
    for body_path in (paths[0], paths[3]):
        if os.path.isfile(body_path):
            with open(body_path, encoding='utf-8') as fixture:
                text = fixture.read()
    if os.path.isfile(paths[1]):
        with open(paths[1], encoding='utf-8') as fixture:
            exit_code = int(fixture.read().strip() or 0)
    return text, exit_code


for folder in folders:
    found = answer(folder, key) or answer(folder, 'any')
    if found:
        body, code = found
        break
body = body.replace('@ATHENA@', os.environ.get('FAKE_ATHENA', ''))
if body:
    sys.stdout.write(body.rstrip('\n') + '\n')
sys.exit(code)
