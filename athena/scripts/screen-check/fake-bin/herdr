#!/usr/bin/env python3
"""가짜 herdr — 화면 계층 회귀 검사(scripts/screen-check/check.sh)용. 진짜 herdr 서버는 건드리지 않는다.

받은 인자를 한 줄 JSON 으로 $FAKE_HERDR_LOG 에 적고, 응답은 고정 파일(fixture)에서 준다.
  FAKE_HERDR_FIXTURE  fixture 폴더 목록(':' 로 구분 · 앞이 우선 · 이름이 studio 로 시작하는 폴더는 건너뜀). 파일 이름은 하위 명령 두 단어 — pane list → pane_list.json
                      <이름>.exit 가 있으면 그 종료 코드로, <이름>.stderr 가 있으면 그 글을 표준오류로. 파일이 없으면 {"result":{"type":"ok"}} · 0
  FAKE_ATHENA         응답 안의 @ATHENA@ 를 이 경로로 바꾼다(작업 트리 사본)
"""
import json
import os
import sys

args = sys.argv[1:]
log = os.environ.get('FAKE_HERDR_LOG')
if log:
    with open(log, 'a', encoding='utf-8') as out:
        out.write(json.dumps(args, ensure_ascii=False) + '\n')

words = [arg for arg in args if not arg.startswith('-')][:2]
key = '_'.join(words) or 'none'
body, code = None, 0
for folder in filter(None, os.environ.get('FAKE_HERDR_FIXTURE', '').split(':')):
    if os.path.basename(folder.rstrip('/')).startswith('studio'):
        continue   # studio* 는 가짜 데몬 CLI(athena-studio-cli) 몫
    path, exit_path, err_path = (os.path.join(folder, key + ext) for ext in ('.json', '.exit', '.stderr'))
    if not any(os.path.isfile(item) for item in (path, exit_path, err_path)):
        continue
    if os.path.isfile(err_path):
        with open(err_path, encoding='utf-8') as fixture:
            sys.stderr.write(fixture.read())
    if os.path.isfile(path):
        with open(path, encoding='utf-8') as fixture:
            body = fixture.read()
    if os.path.isfile(exit_path):
        with open(exit_path, encoding='utf-8') as fixture:
            code = int(fixture.read().strip() or 0)
    break
if body is None:
    body = json.dumps({'id': 'fake:' + key, 'result': {'type': 'ok'}})
body = body.replace('@ATHENA@', os.environ.get('FAKE_ATHENA', ''))
sys.stdout.write(body.rstrip('\n') + '\n')
sys.exit(code)
